/exe-dist/
/exe-dist-*/
node_modules/
/playwright-probe.json
/playwright-repro.json
/temp-*.mjs
/temp-*.cjs

# Build output (generated by `npm run build`, not source)
/dist/

# Ad-hoc debug harness scratch data (session logs/config, not project source)
/.dbg/

# Python bytecode cache
__pycache__/
*.pyc

# Editor/OS/scratch scraps
/temp_test_output*.txt

# Saved/exported third-party web pages and vendor library files (local
# reference material only; not read by the app, build, or tests)
/docs/imported/

# Teacher/student accounts (hashed passwords, progress)
/data/

# Pyodide (среда Python) скачивается скриптом scripts/fetch-pyodide.cjs
/static/vendor/pyodide/

# Референс: диск Пионера с модулем Razero (бинарные blob'ы; текст оставлен в рабочем дереве)
/reference/razero-disk/_binaries/
/reference/razero-disk/**/*.so
/reference/razero-disk/usr/local/bin/*/dist/
/reference/razero-disk/usr/local/bin/*/static/blockly/
/reference/razero-disk/usr/local/share/fastddsgen/

# Референс Мини 2: полный образ корневой ФС с дрона (архив, много ГБ) и снятые блобы
/reference/mini2-full/
/reference/mini2-disk/_binaries/
/reference/mini2-disk/**/*.so
/reference/mini2-disk/usr/local/bin/*/dist/

# Страницы уроков для поисковиков строит scripts/generate-seo-pages.mjs
/static/uroki/
/static/sitemap-lessons.xml
