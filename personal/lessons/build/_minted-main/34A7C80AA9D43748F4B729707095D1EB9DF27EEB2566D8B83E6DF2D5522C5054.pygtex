\begin{Verbatim}[commandchars=\\\{\}]
\PYG{c+c1}{\PYGZsh{} Переменные и типы данных}
\PYG{n}{name} \PYG{o}{=} \PYG{l+s+s2}{\PYGZdq{}Pioneer\PYGZdq{}}  \PYG{c+c1}{\PYGZsh{} Строка (str)}
\PYG{n}{altitude} \PYG{o}{=} \PYG{l+m+mf}{1.5}    \PYG{c+c1}{\PYGZsh{} Число с плавающей точкой (float)}
