\begin{Verbatim}[commandchars=\\\{\}]
\PYG{o}{\PYGZhy{}\PYGZhy{}} \PYG{n}{классификация} \PYG{n}{числа} \PYG{n}{x}\PYG{p}{:} \PYG{n}{каскад} \PYG{k}{if} \PYG{o}{/} \PYG{n}{elseif} \PYG{o}{/} \PYG{k}{else}
\PYG{n}{local} \PYG{n}{function} \PYG{n}{classify}\PYG{p}{(}\PYG{n}{x}\PYG{p}{)}
  \PYG{k}{if} \PYG{n}{x} \PYG{o}{\PYGZgt{}} \PYG{l+m+mi}{0} \PYG{n}{then}
    \PYG{k}{return} \PYG{l+s+s2}{\PYGZdq{}positive\PYGZdq{}}
  \PYG{n}{elseif} \PYG{n}{x} \PYG{o}{==} \PYG{l+m+mi}{0} \PYG{n}{then}
    \PYG{k}{return} \PYG{l+s+s2}{\PYGZdq{}zero\PYGZdq{}}
  \PYG{k}{else}
    \PYG{k}{return} \PYG{l+s+s2}{\PYGZdq{}negative\PYGZdq{}}
  \PYG{n}{end}
\PYG{n}{end}

\PYG{n+nb}{print}\PYG{p}{(}\PYG{n}{classify}\PYG{p}{(}\PYG{l+m+mi}{5}\PYG{p}{))}    \PYG{o}{\PYGZhy{}\PYGZhy{}} \PYG{n}{positive}
\PYG{n+nb}{print}\PYG{p}{(}\PYG{n}{classify}\PYG{p}{(}\PYG{l+m+mi}{0}\PYG{p}{))}    \PYG{o}{\PYGZhy{}\PYGZhy{}} \PYG{n}{zero}
\PYG{n+nb}{print}\PYG{p}{(}\PYG{n}{classify}\PYG{p}{(}\PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{3}\PYG{p}{))}   \PYG{o}{\PYGZhy{}\PYGZhy{}} \PYG{n}{negative}
\end{Verbatim}
